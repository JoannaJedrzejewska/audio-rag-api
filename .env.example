# Adres ChromaDB (w Docker Compose: host.docker.internal:8001)
CHROMADB_HOST=localhost
CHROMADB_PORT=8001

# Model Whisper: tiny, base, small, medium, large
WHISPER_MODEL=small

# Model embeddingów (sentence-transformers)
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Nazwa kolekcji w ChromaDB
CHROMA_COLLECTION=transcriptions

# LLM provider: gemini | openai | local
LLM_PROVIDER=gemini

# Klucze API (uzupełnij własny klucz)
GEMINI_API_KEY=
OPENAI_API_KEY=

# DNS dla kontenerów (Codespaces/Azure; w innym środowisku ustaw DNS hosta)
DOCKER_DNS_SERVER=168.63.129.16

# Limit rozmiaru pliku audio w MB
MAX_FILE_SIZE_MB=25

# Port serwera
PORT=8000
