# Uruchomienie API poza Dockerem:
# ChromaDB uruchomiona na hoście przez: -p 8001:8000
CHROMADB_HOST=127.0.0.1
CHROMADB_PORT=8001

# Model Whisper: tiny, base, small, medium, large
WHISPER_MODEL=small

# Model embeddingów
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Nazwa kolekcji ChromaDB
CHROMA_COLLECTION=transcriptions

# Provider LLM: gemini | openai | local
LLM_PROVIDER=gemini

# Klucze API — wpisuj wyłącznie do lokalnego pliku .env
GEMINI_API_KEY=
OPENAI_API_KEY=

# Maksymalny rozmiar uploadowanego audio w MB
MAX_FILE_SIZE_MB=350

# Port FastAPI
PORT=8000
