# Adres ChromaDB (w Docker Compose: http://chromadb:8001)
CHROMADB_HOST=localhost
CHROMADB_PORT=8001

# Model Whisper: tiny, base, small, medium, large
WHISPER_MODEL=small

# Model embeddingów (sentence-transformers)
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Nazwa kolekcji w ChromaDB
CHROMA_COLLECTION=transcriptions

# LLM provider: gemini | openai | local
LLM_PROVIDER=gemini

# Klucze API (wypełnij swoje)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Limit rozmiaru pliku audio w MB
MAX_FILE_SIZE_MB=25

# Port serwera
PORT=8000
